NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional PostHog connection. Keep this key on the server only.
POSTHOG_PERSONAL_API_KEY=
# Optional comma-separated HTTPS hostnames for a self-hosted PostHog instance.
POSTHOG_ALLOWED_HOSTS=
# Optional server-only OpenAI Responses API assistant; never use NEXT_PUBLIC_.
OPENAI_API_KEY=
# Meta Ads private pilot: server only, scoped to one verified project.
META_ADS_ACCESS_TOKEN=
META_ADS_WORKSPACE_ID=
META_ADS_PROJECT_ID=
META_ADS_ACCOUNT_ID=
# Optional separate ads_management token; initial write supports empty PAUSED campaigns only.
META_ADS_WRITE_ACCESS_TOKEN=
# Server-only 32 random bytes as 64 hexadecimal characters. Never use NEXT_PUBLIC_.
# Preserve this key: changing it requires re-entering saved integration credentials.
INTEGRATIONS_ENCRYPTION_KEY=
